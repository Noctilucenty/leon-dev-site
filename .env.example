# Copy to .env for local development. NEVER commit a real key.
# On Render, set these in the service's Environment tab instead.

# Required — the assistant will refuse to answer without it
OPENAI_API_KEY=your_openai_api_key_here

# Optional — defaults shown
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT=700
PORT=8787

# Optional, strongly recommended — send an off-host copy of every lead.
# On Render use Resend over HTTPS; outbound SMTP is unavailable there.
# RESEND_API_KEY + LEAD_TO_EMAIL are the required pair. LEAD_FROM_EMAIL is
# optional; use a sender on a domain verified in the Resend account.
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=

# SMTP fallback for local development, a VPS, or another host that permits
# outbound SMTP. SMTP_PORT defaults to 587 when blank. Do not use this route on
# the current Render service. Gmail requires an app password.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Optional — extra allowed browser origin besides leonkelvinli.onrender.com + localhost
EXTRA_ORIGIN=

# Optional durable JSONL storage. On Render this must be a directory inside an
# attached persistent disk (for example /var/data/leon-builds). Leaving it blank
# keeps JSONL on the replaceable application filesystem; logs/email still work.
LEON_DATA_DIR=

# Optional signed Cal webhook. Configure the same random secret in Cal and here;
# the endpoint stays 404 and accepts nothing while this is blank.
CAL_WEBHOOK_SECRET=

# Optional off-host acquisition sink. Production URLs must use HTTPS. The token
# is sent as Bearer auth; the secret signs the exact JSON in
# x-leon-signature-256. The receiver must dedupe x-leon-dedupe-key and persist
# before returning 2xx. Set at least one of token/secret. Leave all three blank
# until a real receiver is verified.
ACQUISITION_SINK_URL=
ACQUISITION_SINK_TOKEN=
ACQUISITION_SINK_SECRET=

# Optional — set any long random string to switch on GET /api/leads and
# /api/traffic, and to authorize GET /api/health?deep=1. Shallow /api/health
# remains public. Deep health accepts this value only in the x-leads-key header;
# when LEADS_KEY is unset it returns 404.
# Read it with: curl -H 'x-leads-key: YOUR_KEY' \
#   'https://leon-assist.onrender.com/api/leads?format=json'
LEADS_KEY=
