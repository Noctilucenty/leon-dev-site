# Copy to .env for local development. NEVER commit a real key.
# On Render, set these in the service's Environment tab instead.

# Required — the assistant will refuse to answer without it
OPENAI_API_KEY=your_openai_api_key_here

# Optional — defaults shown
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT=700
PORT=8787

# Optional — email a copy of each lead (any SMTP; Gmail needs an app password)
# Leads are ALWAYS logged to stdout and data/leads.jsonl even without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEAD_TO_EMAIL=

# Optional — extra allowed browser origin besides leonkelvinli.onrender.com + localhost
EXTRA_ORIGIN=
